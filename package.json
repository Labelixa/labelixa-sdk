{
  "name": "labelixa",
  "version": "0.3.0",
  "description": "Render, validate and convert Zebra ZPL (and EPL/TSPL/CPCL) label code via the Labelixa API — SDK and CI-friendly CLI, no printer required.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin/labelixa.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check-publish": "node scripts/check-publish.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "keywords": [
    "zpl",
    "zebra",
    "label",
    "barcode",
    "printing",
    "epl",
    "thermal-printer",
    "tspl",
    "cpcl",
    "cli",
    "linter"
  ],
  "license": "MIT",
  "homepage": "https://labelixa.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Labelixa/labelixa-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Labelixa/labelixa-sdk/issues",
    "email": "support@labelixa.com"
  },
  "bin": {
    "labelixa": "bin/labelixa.mjs"
  }
}
